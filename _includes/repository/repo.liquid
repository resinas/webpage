{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign repo_title = repo_url.last %}
{% else %}
  {% assign repo_title = include.repository %}
{% endif %}
{% assign info = site.data.repo_info[include.repository] %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <div class="repo-card-title"><i class="fa-brands fa-github"></i> {{ repo_title }}</div>
    {% if info.description %}
      <p class="repo-card-description">{{ info.description }}</p>
    {% endif %}
    {% if info %}
      <div class="repo-card-meta">
        {% if info.language -%}
          <span><i class="fa-solid fa-code"></i> {{ info.language }}</span>
        {%- endif %}
        <span><i class="fa-regular fa-star"></i> {{ info.stars }}</span>
        <span><i class="fa-solid fa-code-fork"></i> {{ info.forks }}</span>
        {% if info.archived -%}
          <span>archived</span>
        {%- endif %}
      </div>
    {% endif %}
  </a>
</div>
