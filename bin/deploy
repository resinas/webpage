#!/usr/bin/env bash
#
# Upload the site built by GitHub Actions (gh-pages branch) to the uni web
# server over SFTP. The server is only reachable through the uni VPN, so
# connect to the VPN before running this.
#
# Configuration (environment variables, or a .deploy.env file in the repo root):
#   DEPLOY_HOST        SFTP server hostname                (required)
#   DEPLOY_USER        SFTP username                       (required)
#   DEPLOY_REMOTE_DIR  remote directory  (default: /resinas)
#   DEPLOY_CACHE_DIR   local working copy of gh-pages
#                      (default: ~/.cache/webpage-deploy)
#
# The password is asked for interactively (or your SSH key is used if the
# server accepts it).
#
# usage: bin/deploy [--dry-run] [--delete]
#   --dry-run  show what would be uploaded without changing anything
#   --delete   also remove remote files that no longer exist in the site

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -f "$REPO_ROOT/.deploy.env" ]] && source "$REPO_ROOT/.deploy.env"

REPO_URL="$(git -C "$REPO_ROOT" remote get-url origin)"
DEPLOY_BRANCH="gh-pages"
DEPLOY_REMOTE_DIR="${DEPLOY_REMOTE_DIR:-/resinas}"
DEPLOY_CACHE_DIR="${DEPLOY_CACHE_DIR:-$HOME/.cache/webpage-deploy}"

MIRROR_OPTS="--reverse --only-newer --verbose --exclude-glob .git/ --exclude-glob .nojekyll"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) MIRROR_OPTS="$MIRROR_OPTS --dry-run" ;;
    --delete) MIRROR_OPTS="$MIRROR_OPTS --delete" ;;
    -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

: "${DEPLOY_HOST:?Set DEPLOY_HOST (env var or .deploy.env)}"
: "${DEPLOY_USER:?Set DEPLOY_USER (env var or .deploy.env)}"

if ! command -v lftp >/dev/null; then
  echo "lftp is not installed (macOS: brew install lftp)" >&2
  exit 1
fi

# Keep a persistent working copy of gh-pages. Updating it with reset --hard
# only touches files that changed, so their timestamps tell lftp's
# --only-newer what needs uploading.
if [[ ! -d "$DEPLOY_CACHE_DIR/.git" ]]; then
  echo "Cloning $DEPLOY_BRANCH into $DEPLOY_CACHE_DIR..."
  git clone --branch "$DEPLOY_BRANCH" --single-branch "$REPO_URL" "$DEPLOY_CACHE_DIR"
else
  echo "Updating $DEPLOY_CACHE_DIR..."
  git -C "$DEPLOY_CACHE_DIR" fetch --quiet origin "$DEPLOY_BRANCH"
  git -C "$DEPLOY_CACHE_DIR" reset --quiet --hard "origin/$DEPLOY_BRANCH"
  git -C "$DEPLOY_CACHE_DIR" clean --quiet -fdx
fi

echo "Deploying: $(git -C "$DEPLOY_CACHE_DIR" log -1 --format='%h %ad %s' --date=short)"
echo "Target:    sftp://$DEPLOY_USER@$DEPLOY_HOST$DEPLOY_REMOTE_DIR"

lftp -u "$DEPLOY_USER" "sftp://$DEPLOY_HOST" <<EOF
set sftp:auto-confirm yes
set net:max-retries 2
set net:timeout 20
mirror $MIRROR_OPTS "$DEPLOY_CACHE_DIR" "$DEPLOY_REMOTE_DIR"
bye
EOF

echo "Done."
